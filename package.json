{
  "name": "game-wingman",
  "productName": "Game Wingman",
  "version": "0.1.0",
  "description": "An experimental Windows and macOS TFT companion",
  "repository": { "type": "git", "url": "https://github.com/maxuod/game-wingman.git" },
  "bugs": { "url": "https://github.com/maxuod/game-wingman/issues" },
  "engines": { "node": ">=22.12.0 <23" },
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "check": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "api:check": "npm run build && node --env-file-if-exists=.env scripts/api-check.cjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:desktop": "npm run build && node scripts/smoke.cjs",
    "package:mac": "npm run build && node scripts/package.mjs darwin arm64",
    "package:win": "npm run build && node scripts/package.mjs win32 x64"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "22.20.4",
    "electron": "44.4.5",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
