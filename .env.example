# Local development only. Do not commit .env or place keys in renderer code.
# Read by api:check. The desktop can explicitly import API keys from this file.
AI_ENABLED=false
AI_PROVIDER=deepseek
AI_TIMEOUT_MS=30000

# Model examples verified in official documentation on 2026-09-24.
# Availability depends on your provider account. Override the model ID as needed.
MINIMAX_API_KEY=
MINIMAX_REGION=cn
MINIMAX_MODEL=MiniMax-M3
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
